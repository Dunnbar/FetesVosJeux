# Copier en .env (local) ou définir comme env vars Vercel (prod).
# Voir DEPLOY.md pour le détail du setup.

# ============ Base de données (Postgres) ============
# Local dev : utilise un branch Neon dédié, ou un Postgres Docker local.
# Prod : auto-injecté par l'intégration Vercel ↔ Neon.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Neon expose une URL non-pooled séparée pour les migrations (optionnel,
# fallback sur DATABASE_URL si non défini).
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ============ Storage des images uploadées ============
# Vercel Blob — auto-injecté par l'intégration Vercel ↔ Blob en prod.
# En dev local, laisser vide pour utiliser /public/uploads/ comme fallback.
BLOB_READ_WRITE_TOKEN=""

# ============ Email (Resend) ============
RESEND_API_KEY="re_..."
# Le from doit être un domaine vérifié dans Resend.
# Pour tester rapidement, utiliser onboarding@resend.dev (limité à
# l'adresse du compte Resend).
EMAIL_FROM="Qui S'y Gratte <onboarding@resend.dev>"

# ============ URL publique ============
# Utilisée dans les emails, les liens partagés, les canonicals et le sitemap.
# Lue UNIQUEMENT côté serveur (src/lib/site.ts) : pas de préfixe NEXT_PUBLIC_,
# la valeur n'est donc pas inlinée dans le bundle navigateur. Si un composant
# client en a besoin un jour, passe-la en prop depuis un composant serveur
# plutôt que de remettre le préfixe.
# Local : http://localhost:3000
# Prod  : https://www.quisygratte.fr — AVEC le www, c'est l'hôte qui sert
#         réellement les pages (l'apex redirige en 308). Un canonical ou un
#         sitemap sur l'apex pointe sur une redirection.
SITE_URL="http://localhost:3000"

# ============ Stripe (pas encore branché) ============
# À renseigner quand on implémentera le paiement.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ============ Analytics (Vercel Web Analytics) ============
# Les PAGES VUES sont gratuites et actives dès que Web Analytics est activé
# dans le dashboard Vercel (projet -> Analytics -> Enable).
# Les EVENTS CUSTOM du funnel, eux, exigent un plan Pro : mettre "1" le jour
# du passage en Pro, puis REDÉPLOYER (les NEXT_PUBLIC_* sont inlinées au build).
# En `next dev` les events sont toujours loggés en console et n'envoient rien.
NEXT_PUBLIC_VA_EVENTS="0"
